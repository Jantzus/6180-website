              <div class="lazy-image-container">
                <img class="lazy-image" data-src="${item.url}" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Album image ${index + 1}"/>
