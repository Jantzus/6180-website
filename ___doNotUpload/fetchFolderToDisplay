// Function to detect browser language
function detectLanguage(request) {
  // Get Accept-Language header
  const acceptLanguage = request.headers['accept-language'] || [];
  const langHeader = acceptLanguage.length > 0 ? acceptLanguage[0].value : 'en';
  
  // Parse the Accept-Language header
  const languages = langHeader.split(',').map(lang => {
    const [code, q = 'q=1.0'] = lang.trim().split(';');
    const quality = parseFloat(q.substring(2)) || 1.0;
    return { code: code.split('-')[0], quality };
  }).sort((a, b) => b.quality - a.quality);
  
  // Find the first supported language
  const supportedLang = languages.find(lang => translations[lang.code]);
  
  // Return the language code or default to English
  return supportedLang ? supportedLang.code : 'en';
}

// Function to get translations for the detected language
function getTranslation(langCode) {
  return translations[langCode] || translations['en']; // Default to English if not found
}

exports.handler = (event, context, callback) => {
  const request = event.Records[0].cf.request;

  // Parse URL to get folder path
  if (!request.uri.startsWith("/photos/")) {
    return callback(null, request);
  }

  const folderPath = request.uri.split("/photos/")[1] || "";
  const [prefix, suffix] = folderPath.split("_");

  if (!prefix || !suffix) {
    return callback(null, buildHtmlResponse(400, "Invalid folder ID", request));
  }

  const folderId = `${prefix}_____${suffix}____Folder`;
  
  fetchFolder(folderId)
    .then(result => {
      const html = buildHtmlPage(folderId, result, request);
      callback(null, buildHtmlResponse(200, html, request));
    })
    .catch(error => {
      console.error("[ERROR]", error);
      callback(null, buildHtmlResponse(500, buildErrorPage("Failed to fetch album content", request), request));
    });
};

function fetchFolder(folderId) {
  return new Promise((resolve, reject) => {
    const body = JSON.stringify({
      query: FETCH_FOLDERS_QUERY,
      variables: { folderIds: [folderId] },
    });

    const options = {
      hostname: GRAPHQL_ENDPOINT,
      path: "/graphql",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "x-api-key": API_KEY,
        "Content-Length": Buffer.byteLength(body),
      },
    };

    const req = https.request(options, (res) => {
      let data = "";
      res.on("data", (chunk) => {
        data += chunk;
      });
      
      res.on("end", () => {
        try {
          const json = JSON.parse(data);
          const items = json?.data?.fetchFolders?.items || [];
          const mediaItems = [];
          const contacts = {};
          let folderName = "Photos";
          
          if (items.length > 0) {
            // Get folder name if available
            if (items[0]?.folderName && items[0].folderName.length > 1) {
              folderName = items[0].folderName;
            }
            
            // Build contacts map
            (items[0]?.contactsUsingInvite?.items || []).forEach(contact => {
              if (contact?.id && contact?.item?.publicDisplayName) {
                contacts[contact.id] = contact.item.publicDisplayName;
              }
            });
            
            // Get media items
            (items[0]?.fileReferencesPage?.items || []).forEach(ref => {
              const file = ref?.file;
              if (!file?.dataKey) return;

              const { dataKey, thumbnailDataKey, durationInSeconds, ownerContactId } = file;
              const url = `${BUCKET_URL}public/${dataKey}`;

              if (dataKey.startsWith("Input/Image/")) {
                mediaItems.push({ 
                  type: "image", 
                  url,
                  ownerId: ownerContactId
                });
              } else if (dataKey.startsWith("Input/Video/")) {
                // Store the actual thumbnailDataKey value for direct use in the thumbnail URL
                mediaItems.push({
                  type: "video",
                  url,
                  thumbnailUrl: `${BUCKET_URL}public/${thumbnailDataKey}`,
                  duration: formatTime(durationInSeconds),
                  ownerId: ownerContactId
                });
              }
            });
          }
          
          resolve({ mediaItems, folderName, contacts });
        } catch (e) {
          console.error("[ERROR] Parsing GraphQL:", e);
          reject(new Error("Failed to parse GraphQL response"));
        }
      });
    });

    req.on("error", (e) => {
      console.error("[ERROR] GraphQL request:", e);
      reject(new Error("Failed to fetch folder data"));
    });

    req.write(body);
    req.end();
  });
}

function formatTime(seconds = 0) {
  return `${Math.floor(seconds / 60)}:${(seconds % 60).toString().padStart(2, "0")}`;
}

