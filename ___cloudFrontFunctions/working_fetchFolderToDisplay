const https = require("https");

// Simplified Lambda@Edge function focusing only on the dropdown menu
exports.handler = (event, context, callback) => {
  const request = event.Records[0].cf.request;

  // Parse URL to get folder path
  if (!request.uri.startsWith("/photos/")) {
    return callback(null, request);
  }

  const folderPath = request.uri.split("/photos/")[1] || "";
  const [prefix, suffix] = folderPath.split("_");

  if (!prefix || !suffix) {
    return callback(null, buildHtmlResponse(400, "Invalid folder ID"));
  }

  const folderId = `${prefix}_____${suffix}____Folder`;
  
  // Since we're focusing only on the dropdown, we'll skip the GraphQL fetch
  // and just generate a minimal HTML page with the dropdown functionality
  const html = buildMinimalPage(folderId);
  callback(null, buildHtmlResponse(200, html));
};

function buildMinimalPage(folderId) {
  return `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Album Menu</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/app/favicon.ico">
  <style>
    body { font-family: Helvetica, Arial, sans-serif; max-width: 800px; margin: auto; background: #f9fafb; color: #333; line-height: 1.5; }
    .header { position: sticky; top: 0; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.06); z-index: 10; margin-bottom: 15px; }
    .header-content { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; }
    .save-button { color: #006adc; border: 1px solid #006adc; background: none; padding: 8px 16px; cursor: pointer; font-weight: 500; }
    .album-title { font-weight: 400; margin: 0; font-size: 20px; }
    .dropdown { position: absolute; right: 0; top: 100%; display: none; background: white; box-shadow: 0 4px 16px rgba(0,0,0,0.06); width: 240px; margin-top: 8px; }
    .dropdown.show { display: block; }
    .dropdown div { padding: 14px 18px; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.03); display: flex; align-items: center; gap: 12px; }
    .dropdown div:hover { background: rgba(0,106,220,0.03); color: #006adc; }
    .dropdown .icon { font-size: 16px; color: #006adc; width: 18px; text-align: center; }
    .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); display: none; justify-content: center; align-items: center; z-index: 20; padding: 20px; box-sizing: border-box; }
    .overlay-content { background: white; padding: 24px; max-width: 90%; max-height: 90vh; overflow-y: auto; }
    .info-message { text-align: center; padding: 40px; font-size: 18px; color: #666; }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-content">
      <h2 id="album-title" class="album-title">6180 Album</h2>
      <div style="position: relative;">
        <button class="save-button" onclick="toggleMenu()">Save Options</button>
        <div id="dropdown-menu" class="dropdown">
          <div onclick="openFilePicker()"><span class="icon">📷</span>Add Photos To Album</div>
          <div onclick="saveToAccount()"><span class="icon">💾</span>Save To Account</div>
          <div onclick="getAlbumQRCode()"><span class="icon">📱</span>Open in 6180 App</div>
        </div>
      </div>
    </div>
  </div>
  
  <input type="file" id="file-input" accept="image/*,video/*" multiple style="display:none" />

  <div id="qr-overlay" class="overlay">
    <div class="overlay-content">
      <img id="qr-img" src="" alt="QR Code" />
    </div>
  </div>

  <div class="info-message">
    This is a simplified page that focuses only on the dropdown menu functionality.
  </div>

  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
  <script>
    // Store folder ID for use in scripts
    const FOLDER_ID = "${folderId}";
    
    document.addEventListener("DOMContentLoaded", () => {
      // File input handler
      document.getElementById("file-input").addEventListener("change", e => {
        const files = Array.from(e.target.files);
        if (!files.length) return;

        alert("Selected " + files.length + " files. In the full implementation, these would be processed and added to the album.");
      });
      
      // Close overlay on click outside content
      document.getElementById('qr-overlay').addEventListener('click', e => {
        if (e.target === e.currentTarget) {
          e.currentTarget.style.display = 'none';
        }
      });
    });

    // Toggle dropdown menu
    function toggleMenu() {
      document.getElementById('dropdown-menu').classList.toggle('show');
    }

    // Add click event listener to close dropdown when clicking outside
    document.addEventListener('click', function(event) {
      // Skip this handler if it was triggered by the toggle button itself
      if (event.target.closest('.save-button')) return;
      
      // Close dropdown if click is outside the dropdown
      const dropdown = document.getElementById('dropdown-menu');
      if (dropdown.classList.contains('show') && !event.target.closest('.dropdown')) {
        dropdown.classList.remove('show');
      }
    });

    // Open file picker
    function openFilePicker() {
      document.getElementById("file-input").click();
    }

    // Save to account
    function saveToAccount() {
      alert("In the full implementation, this would redirect to: /app/save-album.html?folderId=" + FOLDER_ID);
    }

    // Generate QR code
    function getAlbumQRCode() {
      const overlay = document.getElementById('qr-overlay');
      const img = document.getElementById('qr-img');
      const qrText = "https://6180.io/folder/" + FOLDER_ID;
      
      // Generate QR code
      QRCode.toDataURL(qrText, { margin: 1, width: 300 }, (err, url) => {
        if (err) return alert("QR code generation failed");
        img.src = url;
        overlay.style.display = "flex";
      });
    }
  </script>
</body>
</html>
`;
}

function buildHtmlResponse(statusCode, body, contentType = "text/html") {
  return {
    status: String(statusCode),
    statusDescription: statusCode === 200 ? "OK" : "Error",
    headers: {
      "cache-control": [{ key: "Cache-Control", value: "public, max-age=300" }],
      "content-type": [{ key: "Content-Type", value: contentType }],
    },
    body,
  };
}