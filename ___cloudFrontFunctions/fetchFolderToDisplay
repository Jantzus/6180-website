    .header { position: sticky; top: 0; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.06); z-index: 10; margin-bottom: 15px; }
    .header-content { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; }
    .save-button { color: #006adc; border: 1px solid #006adc; background: none; padding: 8px 16px; cursor: pointer; font-weight: 500; }
    .album-title { font-weight: 400; margin: 0; font-size: 20px; }
    .media-container { padding: 20px; }
    .media-block { margin-bottom: 28px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); position: relative; transition: transform 0.2s; }
    .media-block:hover { transform: translateY(-2px); }
    img, video { max-width: 100%; display: block; }
    .video-meta { font-size: 12px; color: #555; margin-top: 4px; }
    .owner-badge { position: absolute; bottom: 12px; right: 12px; background: rgba(255,255,255,0.85); padding: 6px 12px; font-size: 12px; font-weight: 500; }
    .dropdown { position: absolute; right: 0; top: 100%; display: none; background: white; box-shadow: 0 4px 16px rgba(0,0,0,0.06); width: 240px; margin-top: 8px; }
    .dropdown.show { display: block; }
    .dropdown div { padding: 14px 18px; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.03); display: flex; align-items: center; gap: 12px; }
    .dropdown div:hover { background: rgba(0,106,220,0.03); color: #006adc; }
    .dropdown .icon { font-size: 16px; color: #006adc; width: 18px; text-align: center; }
    .loading { text-align: center; padding: 40px; font-size: 18px; color: #666; }
    .error { text-align: center; padding: 40px; font-size: 18px; color: #d32f2f; }
    
    /* New styles for video thumbnails */
    .video-container { cursor: pointer; }
    .thumbnail-wrapper { position: relative; }
    .play-button { 
      position: absolute; 
      top: 50%; 
      left: 50%; 
      transform: translate(-50%, -50%);
      width: 60px;
      height: 60px;
      background-color: rgba(0,0,0,0.7);
      border-radius: 50%;
    }
    .play-button:before {
      content: '';
      position: absolute;
      top: 50%;
      left: 55%;
      transform: translate(-50%, -50%);
      border-style: solid;
      border-width: 15px 0 15px 25px;
      border-color: transparent transparent transparent white;
    }
    .duration-badge {
      position: absolute;
      bottom: 12px;
      left: 12px;
      background: rgba(0,0,0,0.7);
      color: white;
      padding: 4px 8px;
      font-size: 14px;
      border-radius: 4px;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-content">
      <h2 id="album-title" class="album-title">${folderName !== "Photos" ? folderName : ""}</h2>
      <div style="position: relative;">
        <button class="save-button" onclick="toggleMenu()">Save Options</button>
        <div id="dropdown-menu" class="dropdown">
          <div onclick="openFilePicker()"><span class="icon">📷</span>Add Photos To Album</div>
          <div onclick="saveToAccount()"><span class="icon">💾</span>Save To Account</div>
        </div>
      </div>
    </div>
  </div>
  
  <input type="file" id="file-input" accept="image/*,video/*" multiple style="display:none" />

  <div id="media-container" class="media-container">
    ${mediaHtml}
  </div>

  <script>
    // Store folder ID for use in scripts
    const FOLDER_ID = "${folderId}";
    
    document.addEventListener("DOMContentLoaded", () => {
      // File input handler
      document.getElementById("file-input").addEventListener("change", e => {
        const files = Array.from(e.target.files);
        if (!files.length) return;

        Promise.all(files.map(file => new Promise(resolve => {
          const reader = new FileReader();
          reader.onload = evt => resolve({
            fileName: file.name,
            dataUrl: evt.target.result,
            type: file.type
          });
          reader.readAsDataURL(file);
        }))).then(results => {
          localStorage.setItem("selectedPhotos", JSON.stringify(results));
          window.location.href = "/app/save-album.html?folderId=" + FOLDER_ID;
        });
      });
    });

    // Toggle dropdown menu
    function toggleMenu() {
      document.getElementById('dropdown-menu').classList.toggle('show');
    }

    // Add click event listener to close dropdown when clicking outside
    document.addEventListener('click', function(event) {
      // Skip this handler if it was triggered by the toggle button itself
      if (event.target.closest('.save-button')) return;
      
      // Close dropdown if click is outside the dropdown
      const dropdown = document.getElementById('dropdown-menu');
      if (dropdown.classList.contains('show') && !event.target.closest('.dropdown')) {
        dropdown.classList.remove('show');
      }
    });

    // Open file picker
    function openFilePicker() {
      document.getElementById("file-input").click();
    }

    // Save to account
    function saveToAccount() {
      window.location.href = "/app/save-album.html?folderId=" + FOLDER_ID;
    }
    
    // Play video function
    function playVideo(element, videoUrl) {
      const container = element.closest('.media-block');
      
      // Create video element dynamically
      const video = document.createElement('video');
      video.controls = true;
      video.style.width = '100%';
      
      const source = document.createElement('source');
      source.src = videoUrl;
      source.type = 'video/mp4';
      
      video.appendChild(source);
      
      // Replace the thumbnail with the video
      element.replaceWith(video);
      
      // Play the video automatically
      video.play().catch(error => {
        console.error('Error playing video:', error);
        // If autoplay fails, just leave the video element with controls visible
      });
    }
  </script>
