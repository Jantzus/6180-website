          return `
            <div class="media-block video-container">
              <div class="thumbnail-wrapper" onclick="playVideo(this, '${item.url}')">
                <img class="lazy-image" data-src="${item.thumbnailUrl}" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Video thumbnail ${index + 1}" />
                <div class="loading-placeholder"></div>
                <div class="play-button"></div>
                <div class="duration-badge">${item.duration}</div>
              </div>
              ${ownerBadge}
            </div>`;
        }
      }).join("")
    : "<div class='error'>No media found in this album</div>";

  return `
