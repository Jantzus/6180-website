    /* Styling for the header */
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
    }
    
    /* Update the save button to match the UI shown in the image */
    .save-button { 
      color: #006adc; 
      border: 1px solid #ccc;
      border-radius: 4px;
      background: white; 
      padding: 8px 16px; 
      cursor: pointer; 
      font-weight: 500;
      min-width: 80px;
      text-align: center;
    }
    .album-title { font-weight: 400; margin: 0; font-size: 20px; }
    .media-container { padding: 20px; }
    .media-block { 
      height: 100%;  /* Make all media blocks fill their grid cell */
      box-shadow: 0 1px 2px rgba(0,0,0,0.04); 
      position: relative; 
      transition: transform 0.2s;
      margin-bottom: 0; /* Remove the margin-bottom that was causing gaps */
      display: flex;
