<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>${folderName}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/app/favicon.ico">
  <style>
