    // Store folder ID for use in scripts
    const FOLDER_ID = "${folderId}";
    
    // Save album function - redirects directly to the save page
    function saveAlbum() {
      window.location.href = "/app/save-album.html?folderId=" + FOLDER_ID;
    }
    
    // Play video function
    function playVideo(element, videoUrl) {
      const container = element.closest('.media-block');
      
      // Create video element dynamically
      const video = document.createElement('video');
      video.controls = true;
      video.style.width = '100%';
      
      const source = document.createElement('source');
      source.src = videoUrl;
      source.type = 'video/mp4';
      
      video.appendChild(source);
      
      // Replace the thumbnail with the video
      element.replaceWith(video);
      
      // Play the video automatically
      video.play().catch(error => {
        console.error('Error playing video:', error);
        // If autoplay fails, just leave the video element with controls visible
      });
    }
    
    // Change pictures per row function
    function changePicturesPerRow(value) {
      const mediaGrid = document.getElementById('media-grid');
      
      // Remove existing layout classes
      mediaGrid.classList.remove('two-per-row', 'three-per-row', 'four-per-row', 'five-per-row');
      
      // Add the appropriate class based on selection
      if (value === '2') {
        mediaGrid.classList.add('two-per-row');
      } else if (value === '3') {
        mediaGrid.classList.add('three-per-row');
      } else if (value === '4') {
        mediaGrid.classList.add('four-per-row');
      } else if (value === '5') {
        mediaGrid.classList.add('five-per-row');
      }
    }
    
    // Setup Intersection Observer for lazy loading
    document.addEventListener('DOMContentLoaded', function() {
      const lazyImages = document.querySelectorAll('.lazy-image');
      
      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.src = img.dataset.src;
              
              img.onload = function() {
                img.classList.add('loaded');
                // Remove placeholder when image is loaded
                const placeholder = img.parentNode.querySelector('.loading-placeholder');
                if (placeholder) {
                  placeholder.style.display = 'none';
                }
              };
              
              imageObserver.unobserve(img);
            }
          });
        }, {
          rootMargin: '50px 0px',
          threshold: 0.01
        });
        
        lazyImages.forEach(function(img) {
          imageObserver.observe(img);
        });
      } else {
        // Fallback for browsers that don't support Intersection Observer
        // This is a simple implementation that loads all images after a short delay
        setTimeout(function() {
          lazyImages.forEach(function(img) {
            img.src = img.dataset.src;
            img.classList.add('loaded');
          });
        }, 250);
      }
    });
  </script>
