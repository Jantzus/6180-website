{
  "name": "app-src",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transform-i18n": "node src/lib/i18n/transformTranslations.cjs",
    "prebuild": "npm run transform-i18n",
    "deploy": "aws s3 sync ../dist s3://6180-website --delete && npm run invalidate",
    "invalidate": "aws cloudfront create-invalidation --distribution-id E1MOSNTHBN77UB --paths '/*' && aws cloudfront create-invalidation --distribution-id E1OIOI9YGA4QEK --paths '/*'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.787.0",
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.6.0",
    "styled-components": "^6.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/stripe-v3": "^3.1.33",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
