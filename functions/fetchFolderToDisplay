function buildHtmlResponse(statusCode, body, contentType = "text/html") {
  return {
    status: String(statusCode),
    statusDescription: statusCode === 200 ? "OK" : "Error",
    headers: {
      "cache-control": [
        {
          key: "Cache-Control",
          value: "public, max-age=300",
        },
      ],
      "content-type": [
        {
          key: "Content-Type",
          value: contentType,
        },
      ],
    },
    body,
  };
}