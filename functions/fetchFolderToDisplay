const https = require("https");

const GRAPHQL_ENDPOINT = "nmu355vgsbdbjcihhtekwdczxi.appsync-api.us-east-1.amazonaws.com";
const API_KEY = "da2-45aunjrsbfbdhlaaomrswhsszq";
const BUCKET_URL = "https://i6180-assets-prod-0.s3.amazonaws.com/";

const FETCH_FOLDERS_QUERY = `
  query FetchFolders($folderIds: [String!]!) {
    fetchFolders(folderIds: $folderIds) {
      items {
        id
        folderName
        fileReferencesPage {
          items {
            id
            file {
              id
              dataKey
              thumbnailDataKey
              durationInSeconds
            }
          }
        }
      }
    }
  }
`;

exports.handler = async (event, context, callback) => {
  const request = event.Records[0].cf.request;

  if (!request.uri.startsWith("/photos/")) {
    return callback(null, request);
  }

  const folderPath = request.uri.split("/photos/")[1] || "";
  const [prefix, suffix] = folderPath.split("_");

  if (!prefix || !suffix) {
    return callback(null, buildHtmlResponse(400, "Invalid folder ID"));
  }

  const folderId = `${prefix}_____${suffix}____Folder`;

  const graphqlRes = await makeGraphQLRequest(folderId);
  if (!graphqlRes.success) {
    return callback(null, buildHtmlResponse(500, "Failed to fetch folder metadata"));
  }

  const html = buildHtmlPage(folderId, graphqlRes.mediaItems);
  return callback(null, buildHtmlResponse(200, html, "text/html"));
};

function makeGraphQLRequest(folderId) {
  return new Promise((resolve) => {
    const body = JSON.stringify({
      query: FETCH_FOLDERS_QUERY,
      variables: { folderIds: [folderId] },
    });

    const options = {
      hostname: GRAPHQL_ENDPOINT,
      path: "/graphql",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "x-api-key": API_KEY,
        "Content-Length": body.length,
      },
    };

    const req = https.request(options, (res) => {
      let data = "";
      res.on("data", (chunk) => (data += chunk));
      res.on("end", () => {
        try {
          const json = JSON.parse(data);
          const items = json?.data?.fetchFolders?.items ?? [];
          const mediaItems = [];

          items.forEach((folder) => {
            const fileItems = folder?.fileReferencesPage?.items ?? [];

            fileItems.forEach((ref) => {
              const file = ref?.file;
              if (!file) return;

              const { dataKey, thumbnailDataKey, durationInSeconds } = file;

              if (dataKey?.startsWith("Input/Image/")) {
                mediaItems.push({
                  type: "image",
                  url: `${BUCKET_URL}public/${dataKey}`,
                });
              } else if (dataKey?.startsWith("Input/Video/")) {
                mediaItems.push({
                  type: "video",
                  url: `${BUCKET_URL}public/${dataKey}`,
                  thumb: `${BUCKET_URL}public/${thumbnailDataKey}`,
                  duration: formatDuration(durationInSeconds),
                });
              }
            });
          });

          resolve({ success: true, mediaItems });
        } catch (e) {
          console.error("[ERROR] Parsing GraphQL response failed:", e);
          resolve({ success: false });
        }
      });
    });

    req.on("error", (e) => {
      console.error("[ERROR] GraphQL request failed:", e);
      resolve({ success: false });
    });

    req.write(body);
    req.end();
  });
}

function formatDuration(seconds = 0) {
  const min = Math.floor(seconds / 60);
  const sec = seconds % 60;
  return `${min}:${sec.toString().padStart(2, "0")}`;
}

